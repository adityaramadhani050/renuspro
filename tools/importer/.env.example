# ── Database tujuan ─────────────────────────────────────────────────────────
# Koneksi LANGSUNG ke Postgres Supabase (bukan PostgREST). Importer perlu
# menonaktifkan trigger dan melewati RLS, jadi gunakan connection string
# milik user postgres — ada di Supabase Dashboard → Project Settings → Database.
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres

# ── Sumber Google Sheets ────────────────────────────────────────────────────
# ID spreadsheet, diambil dari URL:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# Service account JSON dengan akses read-only ke spreadsheet di atas.
# Jangan lupa BAGIKAN spreadsheet-nya ke alamat email service account tersebut.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ── Autentikasi (opsional, hanya untuk --create-auth-users) ─────────────────
# Master_User tidak punya kolom email, sedangkan Supabase Auth memerlukannya.
# Email diturunkan sebagai <username>@<domain>. Bisa ditimpa per user lewat
# users.csv (buat templatenya dengan --emit-user-template).
AUTH_EMAIL_DOMAIN=

SUPABASE_URL=https://xxxxxxxx.supabase.co
# Kunci service_role — RAHASIA. Jangan pernah dipakai di frontend.
SUPABASE_SERVICE_ROLE_KEY=
