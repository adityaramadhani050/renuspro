# ── Konfigurasi E2E RenusPro ────────────────────────────────────────────────
# Salin file ini menjadi `.env` lalu isi. JANGAN commit `.env` (sudah di-ignore).

# URL aplikasi yang sudah ter-deploy (Vercel) & tersambung Supabase asli.
E2E_BASE_URL=https://renuspro.vercel.app

# ── Akun tes per peran (username + password) ────────────────────────────────
# Isi hanya peran yang ingin diuji; peran tanpa kredensial akan otomatis di-skip.
# GUNAKAN AKUN/DATA TES — bukan produksi — karena flow tulis akan membuat data.
# Username = username app (tanpa domain); backend menambahkan domain email sendiri.

E2E_ADMIN_USER=
E2E_ADMIN_PASS=

E2E_SALES_USER=
E2E_SALES_PASS=

E2E_FINANCE_USER=
E2E_FINANCE_PASS=

E2E_PROCUREMENT_USER=
E2E_PROCUREMENT_PASS=

E2E_WAREHOUSE_USER=
E2E_WAREHOUSE_PASS=

E2E_SITEENGINEER_USER=
E2E_SITEENGINEER_PASS=

E2E_LEADENGINEER_USER=
E2E_LEADENGINEER_PASS=

# ── Saklar flow tulis ───────────────────────────────────────────────────────
# Default 0 = hanya smoke read-only (login, navigasi, cek error konsol/render).
# Set 1 untuk mengaktifkan test yang MEMBUAT/MENGUBAH data (mis. draft penawaran).
E2E_ALLOW_WRITES=0
